# ==========================================
# StarUp 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ==========================================

# ------------------------------------------
# LLM 配置 (必填)
# ------------------------------------------
# 通用 LLM 配置（推荐，方便统一管理）
LLM_PROVIDER=deepseek
LLM_API_KEY=DEEPSEEK_API_KEY
LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=8192

# 按意图指定模型（可选，未设置时回退到 LLM_MODEL）
# LLM_MODEL_CODE=deepseek-coder
# LLM_MODEL_ANALYSIS=deepseek-chat
# LLM_MODEL_SEARCH=deepseek-chat
# LLM_MODEL_EXPLANATION=deepseek-chat
# LLM_MODEL_GENERAL=deepseek-chat
# LLM_FALLBACK_MODEL=deepseek-chat

# 兼容旧版 DeepSeek 专用变量（当通用变量未设置时生效）
# DEEPSEEK_API_KEY=DEEPSEEK_API_KEY
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI API Key (可选)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4

# ------------------------------------------
# 飞书配置 (可选)
# ------------------------------------------
FEISHU_ENABLED=false
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# ------------------------------------------
# 微信配置 (可选)
# ------------------------------------------
WEIXIN_ENABLED=false
WEIXIN_CORP_ID=your-corp-id
WEIXIN_SECRET=your-secret

# ------------------------------------------
# Telegram 配置 (可选)
# ------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ------------------------------------------
# 钉钉配置 (可选)
# ------------------------------------------
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=your-dingtalk-client-id
DINGTALK_CLIENT_SECRET=your-dingtalk-client-secret
# 兼容旧版变量名
# DINGTALK_APP_KEY=your-app-key
# DINGTALK_APP_SECRET=your-app-secret

# ------------------------------------------
# Gateway 配置
# ------------------------------------------
STARUP_GATEWAY_HTTP_PORT=18788
STARUP_GATEWAY_WS_PORT=18789
# STARUP_GATEWAY_TOKEN=your-secure-token

# ------------------------------------------
# 日志配置
# ------------------------------------------
# LOG_LEVEL=info  # debug, info, warn, error

# 云效
YUNXIAO_ORG_ID=your_yunxiao_org_id
YUNXIAO_TOKEN=your_yunxiao_token
